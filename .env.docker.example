# .env.docker — the web app against the LOCAL Supabase stack (Docker).
#
# `npm run local:start` writes the real .env.docker from `supabase status`; this
# file only shows the shape. Vite loads it with `--mode docker` (npm run dev:docker),
# and it overrides .env, so `npm run dev` keeps pointing at live exactly as before.
# Git-ignored (.env.*). Never put live keys in here.

# The local stack (Kong gateway). Same value for auth, PostgREST and storage.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<local anon key, from supabase status>
VITE_SUPABASE_PUBLISHABLE_KEY=

# Empty = the app reads PostgREST directly, as live does today.
# http://localhost:8000 = through the FastAPI layer (docker compose --profile api up).
VITE_API_URL=
VITE_BACKEND=supabase

# No social buttons locally (needs provider secrets; see supabase/config.toml).
VITE_AUTH_PROVIDERS=

# Dev-only sign-in without the email code (scripts/dev-direct-signin.mjs).
# Set to 0 to test the real 6-digit code flow and read codes in Mailpit :54324.
VITE_DIRECT_SIGNIN=1

# Not VITE_-prefixed, so Vite never ships it to the browser. Used only by the
# dev server's direct sign-in route. Local stack's service_role key.
SUPABASE_SECRET_KEY=<local service_role key, from supabase status>

# The local Postgres (no psql on this PC: docker exec -it supabase_db_attackedmap psql -U postgres).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Informational; `npm run local:verify` reads them when the stack is down.
STUDIO_URL=http://127.0.0.1:54323
MAILPIT_URL=http://127.0.0.1:54324
