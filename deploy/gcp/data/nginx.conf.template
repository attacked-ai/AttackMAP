# nginx's image runs envsubst on this at start: ${PORT}, ${PUBLIC_MEDIA_BASE}
# and ${GCS_BUCKET_PREFIX} are filled in; nginx's own $variables are left alone.
server {
    listen ${PORT};
    server_tokens off;
    client_max_body_size 10m;

    # Supabase URL shape -> PostgREST at its root.
    location /rest/v1/ {
        proxy_pass http://127.0.0.1:3000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 60s;
        proxy_buffering on;
    }

    # Old public storage links (stored in rows and in sent emails) keep working:
    # bucket "incident-media" lives in Cloud Storage as <prefix>incident-media.
    location ~ ^/storage/v1/object/public/([A-Za-z0-9._-]+)/(.+)$ {
        return 302 ${PUBLIC_MEDIA_BASE}/${GCS_BUCKET_PREFIX}$1/$2;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location / {
        return 404;
    }
}
