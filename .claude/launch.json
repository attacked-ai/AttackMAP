{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "vite-docker",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:docker",
        "--",
        "--port",
        "5174",
        "--strictPort",
        "--no-open"
      ],
      "port": 5174
    },
    {
      "name": "vite-prod-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4173"
      ],
      "port": 4173
    },
    {
      "name": "static-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5050"
      ],
      "port": 5050
    },
    {
      "name": "nats-briefing",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8127",
        "--bind",
        "127.0.0.1",
        "--directory",
        "D:/claude_work/nats-v2/src"
      ],
      "port": 8127
    },
    {
      "name": "cards-5173",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "D:/attacked-dev/wt-cards",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort",
        "--open",
        "false"
      ],
      "port": 5173
    },
    {
      "name": "live-resp",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "D:/attacked-dev/wt-live-resp",
        "run",
        "dev",
        "--",
        "--port",
        "5175",
        "--strictPort",
        "--open",
        "false"
      ],
      "port": 5175
    }
  ]
}
