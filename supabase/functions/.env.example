# supabase/functions/.env — secrets for edge functions running in the LOCAL stack.
# Copy to supabase/functions/.env (git-ignored). The CLI passes these to the local
# edge runtime only; nothing here reaches the live project.
#
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY are injected by the
# CLI for the local stack automatically. Do not set them here.

# daily-digest, incident-deliver, welcome-email: locally all mail goes to Mailpit
# (http://127.0.0.1:54324), so leave the Gmail/Resend values empty unless you are
# testing a real send on purpose.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=Attacked.ai <brief@attacked.ai>
RESEND_API_KEY=
APP_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5173/?dashboard
UNSUBSCRIBE_POST_URL=

# incident-images / incident-report (Claude). Empty = generation is skipped.
ANTHROPIC_API_KEY=
PUBLIC_MEDIA_BASE=http://127.0.0.1:54321/storage/v1/object/public/

# guard-ingest / attack-map-feed: any random strings locally.
INGEST_TOKEN=local-ingest-token
PARTNER_FEED_KEY=local-partner-key
ADMIN_FEED_KEY=local-admin-key
GUARD_DB_URL=
GUARD_SERVICE_KEY=
GUARD_CONTROLS_TABLE=

# incident-deliver WhatsApp (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
